#!/bin/sh
# Regenerate the ADR index when any ADR file is staged, then re-stage it so the
# refreshed index lands in the same commit, and report any decision whose scope
# covers a staged path. This is the writing-adrs tool the skill ships; the plugin's
# session hooks run the same checks live, and this hook is the fast local aid for a
# commit made from a shell.
# Activate per clone with:
#   git config core.hooksPath .githooks

# Collect staged paths into the positional parameters, one per line. `for path in
# $(...)` would word-split a path containing whitespace into fragments matching
# nothing, and xargs is avoided because the flag for "skip an empty list" differs
# between GNU and BSD.
set --
while IFS= read -r path; do
    [ -n "$path" ] || continue
    set -- "$@" "$path"
done <<STAGED
$(git diff --cached --name-only --diff-filter=ACMR)
STAGED

[ "$#" -gt 0 ] || exit 0

for path in "$@"; do
    case "$path" in
        docs/adr/[0-9]*-*.md)
            python3 skills/writing-adrs/adr.py index || exit 1
            git add docs/adr/INDEX.md
            break
            ;;
    esac
done

# Advisory: a decision worth reading is not a commit worth refusing. This reports
# Archived decisions too, which are in force but kept out of INDEX.md, so it is the
# only place they surface (ADR 013).
bound=$(python3 skills/writing-adrs/adr.py for "$@") || exit 0
[ -n "$bound" ] || exit 0
printf 'Decisions binding these paths:\n%s\n' "$bound"

# Advisory sibling of the block above, over docs/backlog/ instead of docs/adr/: a
# backlog item naming a path that no longer exists is never reported here, and never
# fails the build (ADR 028).
backlog=$(python3 skills/writing-adrs/backlog.py for "$@") || exit 0
[ -n "$backlog" ] || exit 0
printf 'Backlog items concerning these paths:\n%s\n' "$backlog"
